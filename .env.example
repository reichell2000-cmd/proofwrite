# Required; use a long password and a separate random secret (32+ characters).
PROOFWRITE_TEACHER_PASSWORD=
PROOFWRITE_SESSION_SECRET=
# Persist this directory on a mounted volume. One Node process / instance only.
PROOFWRITE_DATA_DIR=.data
# Required behind an HTTPS reverse proxy, e.g. https://proofwrite.school.example
PROOFWRITE_PUBLIC_ORIGIN=

# Optional teacher-only AI review drafts. Both must be configured to enable.
# With neither configured, FREE uses explicitly labeled reading guidance.
# Use a Responses API model supporting strict structured outputs.
PROOFWRITE_AI_API_KEY=
PROOFWRITE_AI_MODEL=
